// 2 Spalten nebeneinander
tt_content.2rowcontainer < lib.contentElement
tt_content.2rowcontainer {
    templateName = Zweirow
    templateRootPaths {
        10 = EXT:sitepackage/Resources/Private/Container/Templates/
    }
    dataProcessing {
        200 = B13\Container\DataProcessing\ContainerProcessor
        200 {
            colPos = 200
            as = children_200
        }
        201 = B13\Container\DataProcessing\ContainerProcessor
        201 {
            colPos = 201
            as = children_201
        }
    }
}
